# ID Google Sheet Pizza Mako (dari URL: /spreadsheets/d/<INI_ID>/edit)
GOOGLE_SHEET_ID=

# Kredensial Service Account (dari Google Cloud Console -> IAM & Admin -> Service Accounts)
# Buat service account, generate JSON key, lalu share Google Sheet-mu ke email
# service account tsb dengan akses "Editor".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key dari file JSON. Ganti newline literal jadi \n saat ditaruh di .env
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opsional: webhook n8n untuk order offline (biar CRM ikut ke-upsert, lihat PZM-03)
N8N_ORDER_WEBHOOK_URL=

# Opsional: webhook n8n (PZM-00) untuk trigger refresh cache menu SEGERA
# setelah toggle Aktif/Nonaktif - biar menu habis langsung kepakai AI,
# nggak nunggu jadwal cron 1 jam
N8N_CACHE_REFRESH_WEBHOOK_URL=

# Password sederhana untuk lindungi dashboard (opsi A, lihat README - Autentikasi)
DASHBOARD_ACCESS_PASSWORD=
