    {
      "parameters": {
        "jsCode": "const today = $now.setZone('Asia/Jakarta').toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(i => i.json).filter(r => String(r.Timestamp || '').startsWith(today));\n\nlet totalOmset = 0;\nlet jumlahOrder = rows.length;\nconst menuCount = {};\n\nfor (const r of rows) {\n  totalOmset += Number(r.Total) || 0;\n  let items = [];\n  try { items = JSON.parse(r['Detail Item'] || '[]'); } catch (e) { items = []; }\n  for (const it of items) {\n    const key = it.menu || 'Tidak diketahui';\n    menuCount[key] = (menuCount[key] || 0) + (it.qty || 1);\n  }\n}\n\nlet terlaris = '-';\nlet maxQty = 0;\nfor (const [menu, qty] of Object.entries(menuCount)) {\n  if (qty > maxQty) { maxQty = qty; terlaris = menu; }\n}\n\nreturn [{ json: { today, totalOmset, jumlahOrder, terlaris, maxQty } }];"
      },
