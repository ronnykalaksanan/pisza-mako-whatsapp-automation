    {
      "parameters": {
        "jsCode": "const now = DateTime.now();\nconst rows = $input.all().map(i => i.json);\nconst expired = rows.filter(r => {\n  if (r['Bot Aktif'] !== 'FALSE') return false;\n  const pausedAt = r['Bot Dijeda Sejak'];\n  if (!pausedAt) return false;\n  const diffHours = now.diff(DateTime.fromISO(pausedAt), 'hours').hours;\n  return diffHours >= 2;\n});\nreturn expired.map(r => ({ json: r }));"
      },
